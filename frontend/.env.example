# Vite loads env files by mode:
#
#   npm run dev    -> .env.development  (VITE_API_URL=http://localhost:5236)
#   npm run build  -> .env.production   (VITE_API_URL= , i.e. same-origin)
#
# Both are committed, so there is usually nothing to copy. Create .env.local only
# if you need to override the base URL for yourself — it wins over both and is
# gitignored.
#
# Anything prefixed VITE_ is baked into the bundle at build time and is publicly
# visible in the shipped JS — never put secrets here.
VITE_API_URL=http://localhost:5236
