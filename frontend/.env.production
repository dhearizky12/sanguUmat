# Loaded only by `npm run build` (mode=production).
#
# The UI is a static site (sanguumat.web.id), so this must be the API's absolute
# public origin with no trailing slash, e.g. https://api.sanguumat.web.id.
# Left empty the bundle calls its own origin ("/api/..."), which only works when
# the API itself serves the bundle.
#
# Anything prefixed VITE_ is baked into the bundle at build time and is publicly
# visible in the shipped JS — never put secrets here.
VITE_API_URL=
PORT=3001
