# Loaded only by `npm run build` (mode=production).
#
# The UI is a static site (sanguumat.web.id), so this is the API's absolute public
# origin plus its path prefix, with no trailing slash. The API's CORS list must
# include the UI's origin (EXTRA_CORS_ORIGIN in deploy/.env).
#
# Anything prefixed VITE_ is baked into the bundle at build time and is publicly
# visible in the shipped JS — never put secrets here.
VITE_API_URL=https://se-224.tail3f5844.ts.net/sanguumat
PORT=3001
