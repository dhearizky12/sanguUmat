# Template for deploy/.env — copy and fill in:
#
#   cp .env.example .env
#
# .env is gitignored because it holds the database password and the Google client
# secret. Keep this template in sync when you add a setting.

# ---- Postgres (runs in the db container) ----
POSTGRES_DB=sanguumat
POSTGRES_USER=sanguumat
POSTGRES_PASSWORD=CHANGE_ME
# Host port for psql/pgAdmin from this machine (loopback only). 5433 by default so
# it does not clash with a natively installed Postgres on 5432.
POSTGRES_HOST_PORT=5433

# ---- API ----
# Host port the API is published on, loopback only — handy for hitting
# http://localhost:8080 directly while debugging, and what a reverse proxy points at.

API_HOST_PORT=8080

# ---- Public URL ----
# Where the UI lives, with scheme and no trailing slash: https://sanguumat.web.id.
# After Google sign-in the API sends the browser here, with the login token.
PUBLIC_BASE_URL=https://sanguumat.web.id

# ---- Mount path ----
# URL path prefix the API is served under on its own host. The proxy keeps it and
# the API strips it: https://se-224.tail3f5844.ts.net/sanguumat/api/... Empty = root.
APP_BASE_PATH=/sanguumat

# ---- Google OAuth ----
# From console.cloud.google.com > APIs & Services > Credentials. The authorized
# redirect URI must be <API public origin><APP_BASE_PATH>/signin-google, e.g.
# https://se-224.tail3f5844.ts.net/sanguumat/signin-google.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# ---- Login token ----
# Signs the JWT the API hands out after Google sign-in. At least 32 random
# characters, kept secret: `openssl rand -base64 48`. Changing it signs everyone out.
JWT_KEY=CHANGE_ME
JWT_EXPIRY_DAYS=7

# ---- UI origin (CORS) ----
# Where the UI is served from, scheme and host only: https://sanguumat.web.id
EXTRA_CORS_ORIGIN=https://sanguumat.web.id

# Google email that becomes Admin on its first sign-in (before it has ever signed in).
ADMIN_EMAIL=
