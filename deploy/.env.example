# Template for deploy/.env — copy and fill in:
#
#   cp .env.example .env
#
# .env is gitignored because it holds the database password and the Google client
# secret. Keep this template in sync when you add a setting.

# ---- Postgres (runs in the db container) ----
POSTGRES_DB=sanguumat
POSTGRES_USER=sanguumat
POSTGRES_PASSWORD=CHANGE_ME
# Host port for psql/pgAdmin from this machine (loopback only). 5433 by default so
# it does not clash with a natively installed Postgres on 5432.
POSTGRES_HOST_PORT=5433

# ---- API ----
# Host port the API is published on, loopback only — handy for hitting
# http://localhost:8080 directly while debugging, and what a reverse proxy points at.

API_HOST_PORT=8080

# ---- Public URL ----
# The public address of the site, with scheme and no trailing slash, e.g.
# https://sanguumat.web.id. Used for the post-login and post-logout redirects.
PUBLIC_BASE_URL=https://sanguumat.web.id

# ---- Mount path ----
# URL path prefix the app is served under. Empty = the domain root.
# Must agree with the tail of PUBLIC_BASE_URL and the Google redirect URI.
APP_BASE_PATH=

# ---- Google OAuth ----
# From console.cloud.google.com > APIs & Services > Credentials. The authorized
# redirect URI must be <PUBLIC_BASE_URL>/signin-google.
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET

# ---- Auth cookie ----
# Lax is correct for this setup: one origin, so the cookie is first-party and
# every browser accepts it. Only switch to None if the SPA ever moves back to a
# separate host — and note Firefox and Safari block third-party cookies by
# default, so login silently fails there.
COOKIE_SAMESITE=Lax

# Only for sibling subdomains sharing a registrable domain — the shared parent,
# leading dot included (e.g. .sanguumat.id). Leave empty on a single origin.
COOKIE_DOMAIN=

# ---- Extra CORS origin (optional) ----
# Leave empty in normal use — nothing is cross-origin. Set to http://localhost:3000
# if you want a local `npm run dev` to hit this deployed API instead of a local one.
EXTRA_CORS_ORIGIN=

# Google email that becomes Admin on its first sign-in (before it has ever signed in).
ADMIN_EMAIL=
